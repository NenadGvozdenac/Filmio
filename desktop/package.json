{
  "name": "filmio",
  "productName": "Filmio",
  "version": "1.0.0",
  "description": "Torrent client and player for movies and series",
  "author": "Filmio",
  "main": "src/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/build-icons.mjs",
    "dist": "electron-builder --win nsis"
  },
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^1.77.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "ip": "file:./shims/ip"
  },
  "build": {
    "appId": "app.filmio.desktop",
    "productName": "Filmio",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Filmio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Filmio-Setup-${version}.${ext}"
    }
  }
}
